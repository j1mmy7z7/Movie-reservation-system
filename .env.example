# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored — never commit real secrets.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
# Hostname used in ALLOWED_HOSTS (ngrok domain or server domain, no scheme).
# e.g. NGROK_URL=abc123.ngrok-free.app
NGROK_URL=localhost

# --- Postgres (django-environ reads these in core/settings.py) ---
NAME=reservation_db
USER=reservation_user
PASSWORD=change-me
HOST=localhost
PORT=5432

# --- M-Pesa Daraja ---
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
# Public URL Safaricom POSTs receipts to, e.g. https://abc123.ngrok-free.app/mpesa/callback/
MPESA_CALLBACK_URL=https://your-public-host/mpesa/callback/
# Required by system/serializers/mpesa_seriazlier.py but not yet in settings.py:
# sandbox: https://sandbox.safaricom.co.ke | prod: https://api.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# --- Gunicorn (all optional, defaults in gunicorn.conf.py) ---
# NOTE: .env PORT above is Postgres. Gunicorn uses GUNICORN_PORT.
# GUNICORN_PORT=8000
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=90
# GUNICORN_LOGLEVEL=info
